<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ChromatogramPlotter.Controls"
                    xmlns:viewmodels="clr-namespace:ChromatogramPlotter.ViewModels">

    <Style TargetType="{x:Type controls:PropertyGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PropertyGrid}">

                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="BoolPropertyTemplate">
                            <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" />
                        </DataTemplate>
                        <DataTemplate x:Key="IntPropertyTemplate">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=500}" HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                        <DataTemplate x:Key="DoublePropertyTemplate">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding Value}" Minimum="0.5" Maximum="20" TickFrequency="0.1" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Value, StringFormat={}{0:F1}}" Width="40" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                        <DataTemplate x:Key="AxisWidthPropertyTemplate">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding Value}" Minimum="0.5" Maximum="5" TickFrequency="0.1" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Value, StringFormat={}{0:F1}}" Width="40" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                        <DataTemplate x:Key="FontFamilyPropertyTemplate">
                            <ComboBox ItemsSource="{Binding OptionsSource}"
                                      SelectedValue="{Binding Value}"
                                      IsEditable="True"/>
                        </DataTemplate>
                        <DataTemplate x:Key="StringPropertyTemplate">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=500}" HorizontalAlignment="Stretch"/>
                        </DataTemplate>

                        <controls:PropertyTemplateSelector x:Key="PropertySelector"
                             BoolTemplate="{StaticResource BoolPropertyTemplate}"
                             IntTemplate="{StaticResource IntPropertyTemplate}"
                             DoubleTemplate="{StaticResource DoublePropertyTemplate}"
                             StringTemplate="{StaticResource StringPropertyTemplate}"
                             FontFamilyTemplate="{StaticResource FontFamilyPropertyTemplate}"
                             AxisWidthTemplate="{StaticResource AxisWidthPropertyTemplate}" />
                    </ControlTemplate.Resources>

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" AlternationCount="2">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:PropertyItemViewModel}">
                                        <Grid Margin="5,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                                            <ContentPresenter Grid.Column="1" 
                                                              Content="{Binding}"
                                                              ContentTemplateSelector="{StaticResource PropertySelector}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:SvgView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SvgView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="PART_DrawingCanvas" 
                                    Background="Transparent"/>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>