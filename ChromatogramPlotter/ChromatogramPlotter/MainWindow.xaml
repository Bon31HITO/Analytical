<Window x:Class="ChromatogramPlotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ChromatogramPlotter.ViewModels"
        xmlns:controls="clr-namespace:ChromatogramPlotter.Controls"
        xmlns:mvvm="clr-namespace:ChromatogramPlotter.Mvvm"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1280">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <mvvm:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
        <mvvm:StringToBrushConverter x:Key="StringToBrushConverter" />
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_ファイル(F)">
                <MenuItem Header="_CSVを開く(O)..." Command="{Binding OpenFileCommand}" />
                <MenuItem Header="_SVGを保存(S)..." Command="{Binding SaveSvgCommand}" />
                <Separator />
                <MenuItem Header="_終了(X)" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_編集(E)">
                <MenuItem Header="_SVGをコピー(_C)" Command="{Binding CopySvgCommand}" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="280" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="10,0,5,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                    <TextBlock Text="ヘッダー行数:" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding HeaderRowCount, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="CSVを開く..." Command="{Binding OpenFileCommand}" Margin="0,10,0,10" />
                </StackPanel>

                <GroupBox Header="描画する系列" DockPanel.Dock="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableSeries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:SelectableSeriesViewModel}">
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>

                                        <Rectangle Grid.Column="1" Width="16" Height="16" Margin="5,0" VerticalAlignment="Center"
                                                   Stroke="Black" StrokeThickness="0.5" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Color, Converter={StaticResource StringToBrushConverter}}"
                                                   ToolTip="クリックして色を変更">
                                            <Rectangle.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeColorCommand}" />
                                            </Rectangle.InputBindings>
                                        </Rectangle>

                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </DockPanel>
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,5,10">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="SVGをコピー(_C)" Command="{Binding CopySvgCommand}" />
                        <MenuItem Header="SVGを保存(_S)..." Command="{Binding SaveSvgCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <controls:SvgView SvgSource="{Binding SvgContent}" />
            </Border>
            <DockPanel Grid.Column="2" Margin="5,0,10,10"
                       IsEnabled="{Binding SvgContent, Converter={StaticResource ObjectToBoolConverter}, FallbackValue=False}">
                <TextBlock DockPanel.Dock="Top" Text="プロパティ" FontSize="14" FontWeight="Bold" Margin="5,2,5,5" />
                <controls:PropertyGrid ItemsSource="{Binding PropertyItems}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>